// guacamole_efsd - stable AIDL interface. Cycle 2 Section K, restructured
// 2026-09-24 W1 Finalization Round, item G, into a REAL `aidl_interface`
// module matching this tree's own actual convention - see
// hardware/lineage/interfaces/powershare/aidl/Android.bp, which this
// module's shape (name/srcs/stability/backend layout) directly mirrors.
//
// FROZEN AT VERSION 1 (2026-09-24, via a real `m
// com.guacamole.efsd-update-api` run): `stability: "vintf"` requires
// EITHER a real API snapshot or `unstable: true` - and `unstable: true`
// is itself REJECTED by Soong when `stability: "vintf"` is also set
// ("stability: must be empty when unstable is true", a real build
// error) - because VINTF stability's entire purpose (a durable contract
// across the vendor/system partition boundary this interface actually
// crosses: guacamole_efsd is vendor, Settings is system) is
// incompatible with declaring the interface unstable. So `unstable`
// is NOT used here; the real `aidl_api/com.guacamole.efsd/` snapshot
// below was generated by the build system itself (`m
// com.guacamole.efsd-update-api`), not hand-authored - see that
// directory's own frozen `1/` snapshot and `current/` working copy.
// Any future backwards-compatible change to these .aidl files requires
// re-running that same command to update `current/`; any backwards-
// INCOMPATIBLE change requires cutting a new version first.
//
// MODULE NAMING (found via a real `m` build, 2026-09-24): even while
// unfrozen, this Soong version names the generated per-backend modules
// "com.guacamole.efsd-V1-<backend>" (java/ndk/cpp), NEVER a bare
// "com.guacamole.efsd-<backend>" - confirmed by Soong's own "did you
// mean" error when a same-tree consumer (Settings, the daemon) first
// referenced the unsuffixed name. Every in-tree consumer must use the
// "-V1-" form until/unless this interface is frozen and a new version
// is cut.

package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

aidl_interface {
    name: "com.guacamole.efsd",
    // REQUIRED (found via a real `m` build, 2026-09-24): an
    // aidl_interface defined inside a soong_namespace (this device tree
    // is one - see ../../Android.bp's own soong_namespace{} block) must
    // set `owner`, matching the exact same real convention already used
    // by hardware/oplus/interfaces/Android.bp (owner: "oplus") and
    // hardware/lineage/interfaces/health/aidl/Android.bp (owner:
    // "lineage") elsewhere in this tree.
    owner: "guacamole",
    srcs: ["com/guacamole/efsd/*.aidl"],
    stability: "vintf",
    vendor_available: true,

    backend: {
        java: {
            enabled: true,
            platform_apis: true, // consumed by Settings (Section I),
            // a platform (system) app, not an
            // updatable APK.
        },
        ndk: {
            enabled: true, // consumed by guacamole_efsd itself
            // (Section E, vendor daemon).
        },
        cpp: {
            enabled: true,
        },
    },
    frozen: true,
    versions_with_info: [
        {
            version: "1",
            imports: [],
        },
        {
            version: "2",
            imports: [],
        },

    ],

}
