<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="com.guacamole.efsd.controller">
    <!-- No sharedUserId: PackageManager assigns a dedicated app UID. -->
    <permission android:name="com.guacamole.efsd.CONFIRM_CONFIGURATION" android:protectionLevel="signature" />
    <uses-permission android:name="android.permission.HIDE_NON_SYSTEM_OVERLAY_WINDOWS" />
    <application android:label="Korea configuration confirmation" android:allowBackup="false"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity android:name=".ConfirmationActivity" android:exported="true"
            android:permission="com.guacamole.efsd.CONFIRM_CONFIGURATION" android:excludeFromRecents="true" />
    </application>
</manifest>
